# Discord Chat Mirror - Configuration Reference
# ================================================
# NOTE: This is a REFERENCE FILE ONLY. The actual values are stored in Replit Secrets.
# To edit these values:
# 1. Go to Tools → Secrets in the Replit sidebar
# 2. Edit the secret values there
# 3. Ask me to restart the bot after making changes

# === REQUIRED SETTINGS ===

# Discord bot token (get from https://discord.com/developers/applications)
# WARNING: Using a user token violates Discord TOS
DISCORD_TOKEN=

# Channel IDs to monitor (comma or semicolon separated)
# Example: "1234567890, 9876543210"
# To get channel IDs: Enable Developer Mode in Discord → Right-click channel → Copy ID
CHANNELS_ID="1435254493083340876,1435254493083340877"

# Webhook URLs to forward messages to (comma or semicolon separated)
# Example: "https://discord.com/api/webhooks/..., https://discord.com/api/webhooks/..."
# To create webhooks: Channel Settings → Integrations → Webhooks
WEBHOOKS_URL="https://discord.com/api/webhooks/1435274913756745799/CcwUyR43aXQSKEgujXmD_7aFFcgLgV9riQoYq70xPoHb0JGMG0hE8Qchkw2ZFKf1zoc3,https://discord.com/api/webhooks/1435283502668054620/gPTxBoCMN-MPmg5KdEkhjNkzDIxB6bgS4HlqNXSfXdPI3Iov1OH77k2R6a5c0erMw1oj"

# === OPTIONAL SETTINGS ===

# Add [BOT] or [USER] suffix to usernames (yes/no)
# Default: yes
ENABLE_BOT_INDICATOR=yes

# Use webhook's profile instead of message author's (yes/no)
# Default: no
USE_WEBHOOK_PROFILE=no

# Enable debug logging (yes/no)
# Default: no
DEBUG_MODE=no

# Minimum grade threshold for alert forwarding (0 = disabled)
# Example: 9 means only alerts with Grade >= 9 pass through
# Default: 0 (no grade filter)
ENABLE_GRADE=0

# DeepSeek API key for AI-powered signal/information classification
# Used by the "deepseek-classify" filter group to classify messages as [Signal] or [Information]
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Per-channel filter group (comma/semicolon separated, paired by index with CHANNELS_ID)
#   premium           — Grade >= ENABLE_GRADE  +  Bias/Swing aligned
#   a-only            — Grade letter is "A" (e.g. "A · 9.2")
#   grade-only        — Grade >= ENABLE_GRADE only
#   15m-only          — Interval = 15 only (no grade/bias/swing requirement)
#   no-filter         — no filter (all messages forwarded)
#   deepseek-classify — forward all messages with [Signal]/[Information] prefix via DeepSeek AI
# Default: empty (treated as no-filter for all)
FILTER_GROUPS=

# === BYBIT TRADING ===

# Enable real trading (yes/no)
# "no" = dry-run mode: log what would be executed without placing orders
# "yes" = real mode: place actual orders on Bybit
# Default: no
REAL_TRADE=no

# Bybit API credentials (get from https://www.bybit.com/app/user/api-management)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Maximum loss per trade in USD. Quantity is calculated as MAX_LOSS_PER_TRADE / |entry - sl|
# Example: 50 means risk $50 per trade
MAX_LOSS_PER_TRADE=50

# Which TP level to execute (TP1, TP2, TP3, TP4)
# Falls back to the lowest available TP if the specified level doesn't exist
# Example: TP2 means use TP 2 price; if signal only has TP1, uses TP1
STRATEGY_TYPE=TP2
